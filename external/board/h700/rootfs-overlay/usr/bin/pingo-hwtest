#!/bin/sh
# Pingo OS - checklist de hardware da Fase 0. Rode via SSH ou serial.
# Uso: pingo-hwtest [tudo|tela|botoes|som|bateria|wifi|suspend]

titulo() { printf '\n=== %s ===\n' "$1"; }

tela() {
  titulo "Tela (DRM/KMS)"
  ls /dev/dri 2>/dev/null || echo "sem /dev/dri"
  for c in /sys/class/drm/card*-*; do
    [ -e "$c/status" ] && echo "$(basename "$c"): $(cat "$c/status") $(head -1 "$c/modes" 2>/dev/null)"
  done
  dmesg | grep -i -E 'panel|sun4i-drm|tcon' | tail -5
}

botoes() {
  titulo "Botões e analógicos (evdev)"
  for d in /sys/class/input/event*; do
    echo "$(basename "$d"): $(cat "$d/device/name")"
  done
  echo "Para testar ao vivo: evtest /dev/input/eventN"
}

som() {
  titulo "Áudio (ALSA)"
  aplay -l 2>/dev/null || echo "nenhuma placa de som"
  echo "Teste: speaker-test -t sine -f 440 -l 1   (volume: alsamixer)"
}

bateria() {
  titulo "Bateria"
  for p in /sys/class/power_supply/*; do
    echo "$(basename "$p"):"
    for k in status capacity voltage_now current_now online; do
      [ -r "$p/$k" ] && echo "  $k = $(cat "$p/$k")"
    done
  done
}

wifi() {
  titulo "Wi-Fi"
  ip addr show wlan0 2>/dev/null | grep -E "state|inet " || echo "sem wlan0"
  iw dev wlan0 link 2>/dev/null
}

suspend() {
  titulo "Suspend"
  echo "estados: $(cat /sys/power/state)"
  echo "mem_sleep: $(cat /sys/power/mem_sleep 2>/dev/null)"
  echo "Teste: pingo-suspend-test 60  (suspende e mede consumo)"
}

case "${1:-tudo}" in
  tudo) tela; botoes; som; bateria; wifi; suspend ;;
  *) "$1" ;;
esac
