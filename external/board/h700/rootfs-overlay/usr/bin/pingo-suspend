#!/bin/sh
# Suspende o aparelho com os ajustes de antes/depois que o H700 precisa.
# Uso: pingo-suspend            (acorda pelo botão power)
#      pingo-suspend <segundos> (acorda também pelo RTC)
# Baseado nos hooks sleep.d do ROCKNIX para o H700.
SECS="$1"

# Antes: muta o DAC (evita estalo no alto-falante)
amixer -q cset name='DAC Playback Switch' off 2>/dev/null

# Wi-Fi (RTL8821CS no SDIO): o chip perde a energia no suspend profundo e o
# rtw88 não sabe reinicializá-lo; com ele ligado, o resume trava em timeouts
# do SDIO. O ROCKNIX também desliga o Wi-Fi antes de dormir. Aqui soltamos o
# controlador SDIO inteiro, para o chip ser detectado do zero no resume.
SDIO_HOST=""
for d in /sys/bus/sdio/devices/*; do
  [ -e "$d" ] || continue
  h=$(readlink -f "$d" | sed -n 's|.*/\([^/]*\.mmc\)/mmc_host/.*|\1|p')
  [ -n "$h" ] && { SDIO_HOST="$h"; break; }
done
if [ -n "$SDIO_HOST" ]; then
  /etc/init.d/S41pingo-wifi stop
  echo "$SDIO_HOST" > /sys/bus/platform/drivers/sunxi-mmc/unbind
fi
sync

if [ -n "$SECS" ]; then
  # rtc0 (PCF8563) não acorda o H700; usa o RTC com wakeup habilitado
  RTC=""
  for r in /sys/class/rtc/rtc*; do
    [ "$(cat "$r/device/power/wakeup" 2>/dev/null)" = enabled ] && { RTC="$(basename "$r")"; break; }
  done
  rtcwake -d "${RTC:-rtc0}" -m mem -s "$SECS"
else
  echo mem > /sys/power/state
fi

# Depois: som de volta
amixer -q cset name='DAC Playback Switch' on 2>/dev/null

# O musb derruba a sessão USB no suspend e não a retoma: religa o gadget
G=/sys/kernel/config/usb_gadget/pingo
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -n "$UDC" ] && [ "$(cat $G/UDC 2>/dev/null)" = "$UDC" ]; then
  sleep 3
  if [ "$(cat /sys/class/udc/$UDC/state)" = "not attached" ]; then
    echo "" > $G/UDC; sleep 1; echo "$UDC" > $G/UDC
  fi
fi

# Wi-Fi de volta: religa o controlador SDIO e reconecta (wpa + DHCP)
if [ -n "$SDIO_HOST" ]; then
  echo "$SDIO_HOST" > /sys/bus/platform/drivers/sunxi-mmc/bind
  /etc/init.d/S41pingo-wifi start &
fi
exit 0
