#!/bin/sh
# Som ao ligar, no volume escolhido pelo usuário (Config/sistema.cfg).
# Toca em segundo plano: não atrasa o boot. O pingo-shell corta o som se um
# jogo abrir antes de ele acabar (o ALSA só deixa um programa tocar).
# MENU no Início → Som ao ligar: Desligado grava 0 em Config/som-ao-ligar.txt.
WAV=/usr/share/pingo/ligar.wav
CFG=/mnt/sd1/Config
case "$1" in
  start)
    [ -f "$WAV" ] || exit 0
    [ "$(head -c1 $CFG/som-ao-ligar.txt 2>/dev/null)" = 0 ] && exit 0
    vol=$(sed -n 's/^volume=\([0-9]*\).*/\1/p' $CFG/sistema.cfg 2>/dev/null)
    [ -n "$vol" ] || vol=13 # o mesmo padrão do osd.c (0-20)
    [ "$vol" -gt 0 ] || exit 0
    # osd.c: Line Out 0-31 proporcional aos 20 passos
    amixer -q sset 'Line Out' $((31 * vol / 20)) on
    start-stop-daemon -S -b -q -m -p /run/pingo-som.pid -x /usr/bin/aplay -- -q "$WAV"
    ;;
esac
exit 0
