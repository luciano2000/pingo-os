# Pingo Arcade by Retrogamer Brasil - Raspberry Pi 3 Model B+ (bartop)
# Só arcade (FBNeo). Fase 1: boot, rede, Picade (botões e som), FBNeo.

# Arquitetura
BR2_aarch64=y
BR2_cortex_a53=y

# Toolchain externa (Bootlin, glibc): a mesma do Pingo OS
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y

# Sistema
BR2_TARGET_GENERIC_HOSTNAME="pingo-arcade"
BR2_TARGET_GENERIC_ISSUE="Pingo Arcade by Retrogamer Brasil"
BR2_TARGET_GENERIC_ROOT_PASSWD="pingo"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="America/Sao_Paulo"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PINGO_PATH)/board/arcade/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PINGO_PATH)/board/arcade/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PINGO_PATH)/board/arcade/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_PINGO_PATH)/board/arcade"

# Kernel da Raspberry Pi Foundation (o mesmo commit do raspberrypi3_64_defconfig
# do Buildroot), bcm2711_defconfig, que também serve à Pi 3 em 64 bits
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PINGO_PATH)/board/arcade/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-3-b-plus"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Firmware de boot da Pi (bootcode.bin, start.elf) e overlays
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_PINGO_PATH)/board/arcade/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_PINGO_PATH)/board/arcade/cmdline.txt"
# BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTBS is not set

# Imagem
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_DTC=y

# Wi-Fi da Pi 3 B+ (BCM43455)
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
# kmod-tools (modprobe completo) só aparece com esta opção
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# Ferramentas de teste da Fase 1
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
BR2_PACKAGE_KMSCUBE=y

# Armazenamento
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y

# Rede
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_CA_CERTIFICATES=y

# GPU: VideoCore IV (Mesa vc4), SDL2 em KMS/DRM + GLES
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_TTF=y

# Jogos: FBNeo + pingo-retro
BR2_PACKAGE_LIBRETRO_FBNEO=y
BR2_PACKAGE_PINGO_FRONTEND=y
BR2_PACKAGE_FONT_INTER=y
BR2_PACKAGE_RCHEEVOS=y
BR2_PACKAGE_LIBCHDR=y
