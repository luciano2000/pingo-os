config BR2_PACKAGE_PINGO_FRONTEND
	bool "pingo-frontend"
	depends on BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_TTF
	select BR2_PACKAGE_FONT_INTER
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_RCHEEVOS
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_MBEDTLS
	select BR2_PACKAGE_CA_CERTIFICATES
	help
	  Interface do Pingo OS: pingo-launcher (tela inicial e listas
	  de jogos), pingo-retro (frontend libretro) e pingo-shell (o
	  laço que liga os dois). RetroAchievements pelo rcheevos e libcurl
	  (TLS com mbed TLS).
