#!/bin/sh
# Laço da interface do Pingo OS: launcher -> jogo -> launcher.
# O launcher grava o jogo escolhido em /run/pingo/next e sai; aqui o jogo
# roda como outro processo e, ao sair, o launcher volta para o mesmo lugar.
export HOME=/root
mountpoint -q /mnt/sd1 && export XDG_CACHE_HOME=/mnt/sd1/.system/cache
mkdir -p /run/pingo
rm -f /run/pingo/next /run/pingo/launcher.state /run/pingo/booted

# Fuso escolhido em Data e hora (o relógio do sistema fica em UTC)
load_tz() {
	local z
	z=$(head -n1 /mnt/sd1/Config/fuso.txt 2>/dev/null | tr -d '\r')
	[ -n "$z" ] && [ -e "/usr/share/zoneinfo/$z" ] && export TZ=":$z"
}

# Pingo Arcade (bartop): a galeria de arcade no lugar do launcher
LAUNCHER=/usr/bin/pingo-launcher
grep -q '^ID=pingo-arcade' /etc/os-release && LAUNCHER=/usr/bin/pingo-arcade

while true; do
	load_tz
	$LAUNCHER
	rc=$?
	if [ $rc -eq 3 ]; then # galeria do Arcade: botão de ligar ou Desligar
		sync
		/sbin/poweroff
		exit 0
	fi
	if [ -f /run/pingo/next ]; then
		mode=""
		{ read -r core; read -r rom; read -r console; read -r mode; } < /run/pingo/next
		rm -f /run/pingo/next
		load_tz # pode ter mudado no launcher
		# o som ao ligar ainda tocando prenderia o áudio do jogo
		start-stop-daemon -K -q -p /run/pingo-som.pid -x /usr/bin/aplay 2>/dev/null
		echo "== $(date '+%F %T') $rom"
		if [ "$core" = "port" ]; then
			# port do PortMaster (ou o próprio): roda o script e volta ao launcher
			/usr/sbin/pingo-portmaster run "$rom"
			continue
		fi
		/usr/bin/pingo-retro "$core" "$rom" "$console" $mode
		if [ $? -eq 3 ]; then # power segurado no jogo
			# desenha e deixa no fb0 (fica na tela até apagar)
			$LAUNCHER --message "Desligando…"
			sync
			/sbin/poweroff
			exit 0
		fi
	elif [ $rc -ne 0 ]; then
		sleep 1 # o launcher caiu: evita um laço rápido
	fi
done
