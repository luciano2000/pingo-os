# Opções do core no menu do jogo, uma por linha:
#   chave=Nome mostrado|padrão do Pingo|valor=Nome;valor=Nome
# O padrão e a lista de valores são opcionais (sem a lista, todos os valores
# do core aparecem; ligado/desligado/automático já saem em português).
# As outras opções ficam com o padrão do core.
fceumm_palette=Paleta de cores||default=Padrão;asqrealc=Real (AspiringSquire);nescap=NESCAP;wavebeam=Wavebeam;nes-classic-fbx-fs=NES Classic;rgb=RGB (PlayChoice);pal=PAL
fceumm_nospritelimit=Menos piscadas (sem limite de sprites)
fceumm_region=Região||Auto=Automática;NTSC=NTSC (EUA/Japão);PAL=PAL (Europa);Dendy=Dendy
