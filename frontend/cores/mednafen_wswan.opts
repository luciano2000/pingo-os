# Opções do core no menu do jogo, uma por linha:
#   chave=Nome mostrado|padrão do Pingo|valor=Nome;valor=Nome
# O padrão e a lista de valores são opcionais (sem a lista, todos os valores
# do core aparecem; ligado/desligado/automático já saem em português).
# As outras opções ficam com o padrão do core.
wswan_rotate_display=Girar a tela||manual=Pelo botão;landscape=Deitada;portrait=Em pé
wswan_mono_palette=Cores (WonderSwan)||default=Padrão;wonderswan=WonderSwan;wondeswan_color=WonderSwan Color;swancrystal=SwanCrystal;gb_dmg=Game Boy (verde);gb_pocket=Game Boy Pocket
